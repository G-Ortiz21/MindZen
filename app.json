{
  "expo": {
    "name": "MindZen",
    "slug": "MindZen",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mindzen",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gd21o.MindZen"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "./plugins/withColorSplash.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afbb7081-76b1-48d4-96c0-a459b28e40a0"
      }
    }
  }
}
